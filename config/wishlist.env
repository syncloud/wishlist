NODE_ENV=production
NODE_EXTRA_CA_CERTS=/var/snap/platform/current/syncloud.ca.crt
PRISMA_HIDE_UPDATE_MESSAGE=1
PRISMA_SCHEMA_ENGINE_BINARY={{ .AppDir }}/wishlist/schema-engine.sh
DATABASE_URL=file:{{ .DataDir }}/wishlist.db
SOCKET_PATH={{ .DataDir }}/wishlist.sock
BODY_SIZE_LIMIT=5000000
DEFAULT_CURRENCY=USD
PUBLIC_DEFAULT_CURRENCY=USD
TOKEN_TIME=72
ORIGIN={{ .AppUrl }}
OIDC_ENABLE=true
OIDC_DISCOVERY_URL={{ .AuthUrl }}
OIDC_CLIENT_ID=wishlist
OIDC_CLIENT_SECRET={{ .ClientSecret }}
OIDC_PROVIDER_NAME=Syncloud
OIDC_AUTO_REDIRECT=true
OIDC_AUTO_REGISTER=true
OIDC_ENABLE_SYNC=true
OIDC_GROUPS_CLAIM=groups
OIDC_ADMIN_GROUP=syncloud
SECURITY_DISABLE_PASSWORD_LOGIN=true
ENABLE_SIGNUP=false
